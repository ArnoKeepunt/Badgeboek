rules_version = '2';

// Firebase Storage wordt niet (meer) gebruikt: rapporten worden niet als pdf bewaard — de
// rapportgegevens staan in Firestore en de pdf wordt telkens op aanvraag gemaakt. Alles dicht.
service firebase.storage {
  match /b/{bucket}/o {
    match /{alles=**} {
      allow read, write: if false;
    }
  }
}

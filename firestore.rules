rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Personeelsaccounts (collectie /gebruikers, doc-id = het e-mailadres). Google doet de
    // authenticatie; deze collectie bepaalt WIE toegang heeft en met WELKE rol. Geen wachtwoorden.
    function eigenGebruikerPad() {
      return /databases/$(database)/documents/gebruikers/$(request.auth.token.email);
    }
    function heeftAccount() {
      return isVerified() && exists(eigenGebruikerPad());
    }
    function gebruikerDoc() {
      return get(eigenGebruikerPad()).data;
    }
    function actieveRol() {
      return heeftAccount() && gebruikerDoc().actief == true ? gebruikerDoc().rol : '';
    }
    // Noodluik: kan altijd binnen, ook als /gebruikers leeg of kapot is.
    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'arno.boriau@keerpuntscholen.be';
    }
    function isBeheerder() {
      return isBootstrapAdmin() || actieveRol() == 'beheerder';
    }
    function isPersoneel() {
      return isBootstrapAdmin() ||
        actieveRol() == 'beheerder' || actieveRol() == 'coordinator' || actieveRol() == 'mentor';
    }

    // Afgesloten schooljaren: "vastgezet in september", evaluaties zijn dan alleen-lezen.
    // Spiegelt `AFGESLOTEN_SCHOOLJAREN` in `src/lib/schooljaar.ts` — vast gehouden zodat de regel
    // geen extra document-lees per evaluatie-write nodig heeft. Wordt het afsluiten later een
    // beheerder-actie in de app, dan hier meelezen uit `instellingen/app.afgeslotenSchooljaren`.
    function afgeslotenJaren() {
      return ['2024-2025'];
    }
    function jaarOpen(schooljaar) {
      return !(schooljaar in afgeslotenJaren());
    }

    // Vestiging-afscherming: een mentor ziet enkel leerlingen/evaluaties/deelbadges van zijn
    // eigen vestiging(en); coördinator/beheerder/bootstrap zien alles. De client moet zijn
    // query dan beperken tot `where("vestiging","in", mijnVestigingen)` — Firestore weigert
    // een bredere query dan deze regel toelaat.
    function zietAlleVestigingen() {
      return isBootstrapAdmin()
        || actieveRol() == 'beheerder' || actieveRol() == 'coordinator';
    }
    function mijnVestigingen() {
      let d = gebruikerDoc();
      return d.vestigingen is list ? d.vestigingen
        : ('vestiging' in d && d.vestiging is string && d.vestiging != '') ? [d.vestiging]
        : [];
    }
    function magVestiging(v) {
      return zietAlleVestigingen() || v in mijnVestigingen();
    }

    // --- Personeelsaccounts -----------------------------------------------------
    match /gebruikers/{email} {
      allow get: if isSignedIn() && (email == request.auth.token.email || isBeheerder());
      allow list: if isBeheerder();
      allow create, update: if isBeheerder()
        && request.resource.data.keys().hasOnly(
             ['email', 'naam', 'rol', 'vestiging', 'vestigingen', 'actief', 'dev', 'updatedAt', 'updatedBy'])
        && request.resource.data.rol in ['beheerder', 'coordinator', 'mentor']
        && request.resource.data.actief is bool
        && (!('dev' in request.resource.data) || request.resource.data.dev is bool)
        && (!('vestigingen' in request.resource.data) || request.resource.data.vestigingen is list)
        && (!('vestiging' in request.resource.data) || request.resource.data.vestiging is string);
      allow delete: if isBeheerder();
    }

    // --- Bewerkbare badge-set (curriculum) -----------------------------------
    // Subcollectie-structuur: curriculum/{stroom}/cursussen/{cursusId}/badges/{badgeId}.
    // Iedereen van het personeel mag lezen; enkel de beheerder mag de badge-set wijzigen.
    match /curriculum/{stroom} {
      allow get, list: if isPersoneel();
      allow write: if isBeheerder();

      match /cursussen/{cursusId} {
        allow get, list: if isPersoneel();
        allow write: if isBeheerder();

        match /badges/{badgeId} {
          allow get, list: if isPersoneel();
          allow write: if isBeheerder();
        }
      }
    }

    // collectionGroup-queries op de curriculum-subcollecties (de app luistert zo).
    match /{pad=**}/cursussen/{cursusId} {
      allow list: if isPersoneel();
    }
    match /{pad=**}/badges/{badgeId} {
      allow list: if isPersoneel();
    }

    // --- Instellingen -------------------------------------------------------
    // `instellingen/app` (schooljaar, matrix-filters) rijdt mee in de normale app-save
    // (`bewaar`), dus personeel-breed. `instellingen/overlays` (doel-/rubriekwijzigingen) is
    // beheerder-only: het rijdt NIET mee in `bewaar()` maar heeft een aparte schrijfweg
    // (`schrijfOverlays`, aangeroepen door de store bij een overlay-wijziging).
    match /instellingen/overlays {
      allow get, list: if isPersoneel();
      allow write: if isBeheerder();
    }
    match /instellingen/{sleutel} {
      allow get, list: if isPersoneel();
      allow write: if isPersoneel() && sleutel != 'overlays';
    }

    // --- Vestigingen (campussen): iedereen leest, alleen de beheerder wijzigt ---
    match /vestigingen/{id} {
      allow get, list: if isPersoneel();
      allow write: if isBeheerder();
    }

    // --- Uitgeschreven rubrics: iedereen leest, alleen de beheerder wijzigt ---
    match /rubrieken/{id} {
      allow get, list: if isPersoneel();
      allow write: if isBeheerder();
    }

    // --- Roster + inhoud ----------------------------------------------------
    // `mentoren`/`groepen`/`meldingen` = personeel-breed (id-lijsten / demo-roster; geen
    // leerling-PII die per vestiging afgeschermd moet). `leerlingen` wél per vestiging.
    match /mentoren/{id}     { allow read, write: if isPersoneel(); }
    match /groepen/{id}      { allow read, write: if isPersoneel(); }
    match /meldingen/{id}    { allow read, write: if isPersoneel(); }

    // Leerlingen: een mentor ziet enkel de eigen vestiging(en).
    match /leerlingen/{id} {
      allow read: if isPersoneel() && magVestiging(resource.data.get('vestiging', ''));
      allow write: if isPersoneel() && magVestiging(request.resource.data.get('vestiging', ''));
    }

    // Deelbadges: teacher-made toetsen + scores. Alleen-lezen bij een afgesloten schooljaar
    // (leeg/ontbrekend schooljaar = open). Lezen: eigen vestiging(en) + de overkoepelende
    // (`vestiging == ''`). Schrijven door een mentor: enkel de eigen vestiging(en).
    // Deelbadges: per vestiging afgeschermd, net als `leerlingen`. Een overkoepelende deelbadge
    // (`vestiging == ''`) is coördinator/beheerder-only: Firestore's query-analyzer kan een
    // `vestiging == ''`- of `list.concat()`-tak in de regel niet volgen en zou dan een
    // onbeperkte mentor-query tóch doorlaten.
    match /deelbadges/{id} {
      allow read: if isPersoneel() && magVestiging(resource.data.get('vestiging', ''));
      allow create: if isPersoneel()
        && jaarOpen(request.resource.data.get('schooljaar', ''))
        && magVestiging(request.resource.data.get('vestiging', ''));
      allow update, delete: if isPersoneel()
        && jaarOpen(resource.data.get('schooljaar', ''))
        && magVestiging(resource.data.get('vestiging', ''));
    }

    // --- Evaluaties: /evaluaties/{schooljaar}/leerlingen/{leerlingId} ---------
    // `vestiging` staat gedenormaliseerd op het doc (afgeleid van de leerling). Afgesloten
    // schooljaar → enkel lezen; mentor → enkel de eigen vestiging(en). Uitzondering: op een
    // afgesloten jaar mag het gedenormaliseerde `vestiging`-veld nog toegevoegd worden (migratie).
    match /evaluaties/{schooljaar}/leerlingen/{leerlingId} {
      function alleenVestigingToegevoegd() {
        return resource != null && !('vestiging' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['vestiging', 'updatedAt', 'updatedBy']);
      }
      allow read: if isPersoneel() && magVestiging(resource.data.get('vestiging', ''));
      allow create: if isPersoneel() && jaarOpen(schooljaar)
        && magVestiging(request.resource.data.get('vestiging', ''));
      allow update: if isPersoneel()
        && magVestiging(request.resource.data.get('vestiging', ''))
        && (jaarOpen(schooljaar) || alleenVestigingToegevoegd());
      allow delete: if isPersoneel() && jaarOpen(schooljaar)
        && magVestiging(resource.data.get('vestiging', ''));
    }

    // --- Legacy: oude AI-Studio-documenten -----------------------------------
    // `badgeboek/_globaal`, `badgeboek/{schooljaar}`, `test/*`. De beheerder mag ze lezen
    // (migratie) en wissen (opruimen) via /gegevens. Mag weg zodra de database opgeruimd is.
    match /badgeboek/{doc} {
      allow get, list, delete: if isBeheerder();
    }
    match /test/{doc} {
      allow get, list, delete: if isBeheerder();
    }
  }
}

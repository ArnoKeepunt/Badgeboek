# Kopieer naar `.env` en pas aan. Alle variabelen moeten met VITE_ beginnen.

# Waar de data leeft. Zie src/lib/data/README.md
#   local     — localStorage (standaard, voor de demo)
#   firebase  — Firestore (nog een skelet)
VITE_PERSISTENTIE=local

# Firebase-config (pas nodig zodra VITE_PERSISTENTIE=firebase en firebasePersistentie.ts ingevuld is)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

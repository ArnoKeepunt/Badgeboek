# Kopieer naar `.env` en pas aan. Alle variabelen moeten met VITE_ beginnen.

# Waar de data leeft. Zie src/lib/data/README.md
#   local     — localStorage
#   firebase  — Firestore (geconfigureerd via lokale Firebase-variabelen)
VITE_PERSISTENTIE=firebase

VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Leerling-login via Smartschool (OAuth). Het client id is geen geheim; het client secret
# NOOIT hier zetten — dat staat enkel in de Cloud Function:
#   firebase functions:secrets:set SMARTSCHOOL_CLIENT_SECRET
# Leeg = het client id dat vast in src/lib/data/smartschool.ts staat.
VITE_SMARTSCHOOL_CLIENT_ID=
VITE_SMARTSCHOOL_PLATFORM=keerpunt.smartschool.be
VITE_SMARTSCHOOL_REDIRECT_URI=https://evaluatie.keerpuntscholen.be
